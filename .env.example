# .env にコピーし、EufyアプリのRTSP URLを入力してください。
POOP_RTSP_URL=
# スマートフォンへ ntfy で送る場合のみ、トピック名を設定してください。
POOP_NTFY_TOPIC=
# 見守り通知を分ける場合のみ、通常通知と異なるトピック名を設定してください。
POOP_NTFY_EARLY_TOPIC=
# 自分で運用する ntfy サーバーを使う場合のみ、URL を設定してください（既定は https://ntfy.sh）。
POOP_NTFY_SERVER=

# 判定器に gemini-api を選ぶ場合のみ、Google AI Studio の API キーを設定します。
GEMINI_API_KEY=

# 管理画面に開発者クレジットを表示する場合のみ、BigQuery の請求エクスポートと付与情報を設定します。
# テーブルは「プロジェクト.データセット.テーブル」の形式。通貨は JPY、USD などの3文字。
POOP_GEMINI_BILLING_TABLE=
POOP_GEMINI_CREDIT_ID=
POOP_GEMINI_CREDIT_AMOUNT=
POOP_GEMINI_CREDIT_CURRENCY=
# Cloud Billing のクレジット開始日（YYYY-MM-DD）。
POOP_GEMINI_CREDIT_START_DATE=

# GUI の招待・アドレス確認・パスキー復旧をメールで送る場合のみ設定します。
POOP_SMTP_HOST=
POOP_SMTP_PORT=587
POOP_SMTP_FROM=
POOP_SMTP_USERNAME=
POOP_SMTP_PASSWORD=
