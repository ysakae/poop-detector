# .env にコピーし、EufyアプリのRTSP URLを入力してください。
POOP_RTSP_URL=
# スマートフォンへ ntfy で送る場合のみ、トピック名を設定してください。
POOP_NTFY_TOPIC=
# 見守り通知を分ける場合のみ、通常通知と異なるトピック名を設定してください。
POOP_NTFY_EARLY_TOPIC=
# 自分で運用する ntfy サーバーを使う場合のみ、URL を設定してください（既定は https://ntfy.sh）。
POOP_NTFY_SERVER=

# GUI の招待・アドレス確認・パスキー復旧をメールで送る場合のみ設定します。
POOP_SMTP_HOST=
POOP_SMTP_PORT=587
POOP_SMTP_FROM=
POOP_SMTP_USERNAME=
POOP_SMTP_PASSWORD=
